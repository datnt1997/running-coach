# Copy to frontend/.env (git-ignored) and fill in. Vite bakes these into the
# build, so restart `npm run dev` or re-run `npm run build` after changing them.

# Google OAuth client ID (Google Cloud Console > APIs & Services > Credentials).
# Must be the same value as GOOGLE_CLIENT_ID in the root .env.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
