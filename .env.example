# AI
# Each *_AI_PROVIDER is "anthropic" or "gemini", optionally with a model: "provider:model".
# Without a model, the provider's default below (GEMINI_MODEL / ANTHROPIC_MODEL) is used.

# One model for every role for now; each role stays separately settable so a role can move
# to another model (e.g. gemini:gemini-4-neon) once evals show it is worth the cost.
# Plan generation, activity analysis and weekly summaries.
AI_PROVIDER=gemini:gemini-4-hydrogen
# Fitness chat and Plan chat. Falls back to AI_PROVIDER.
CHAT_AI_PROVIDER=gemini:gemini-4-hydrogen
# The Plan chat's edit step (propose_plan_edit). Falls back to CHAT_AI_PROVIDER, then AI_PROVIDER.
PLAN_EDIT_AI_PROVIDER=gemini:gemini-4-hydrogen

# Gemini: required when any provider above is gemini (pip install -e ".[gemini]")
GEMINI_API_KEY=your_gemini_api_key
# Default Gemini model for a "gemini" setting without a model (code default: gemini-2.0-flash)
GEMINI_MODEL=gemini-4-hydrogen

# Anthropic: required only when a provider above is anthropic, e.g. to move edits back to
# Claude with PLAN_EDIT_AI_PROVIDER=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=your_anthropic_api_key
# Default Claude model for an "anthropic" setting without a model (code default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/running_coach

# Used only by pytest (tests DROP all tables). Database name must end in _test.
# Use the same user/password as POSTGRES_USER / POSTGRES_PASSWORD for the compose file.
# Start it with: docker compose -f docker/docker-compose.yml --profile test up -d db-test
TEST_DATABASE_URL=postgresql://user:password@localhost:5434/running_coach_test

# Strava app registration (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# A secret string you choose — used to verify Strava's webhook handshake
STRAVA_WEBHOOK_VERIFY_TOKEN=your_random_secret_string

# Must match the "Authorization Callback Domain" set in your Strava app
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback

# Sign-in. Google OAuth client id (Google Cloud console, "Web application"); the SPA needs the
# same value at build time as VITE_GOOGLE_CLIENT_ID (frontend/.env).
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Comma-separated emails allowed to sign in; everyone else gets 403
ALLOWED_EMAILS=you@example.com
# Signs the session cookie; at least 32 characters, the app refuses to start otherwise.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# The session cookie is https-only by default. Local development over http needs false
COOKIE_SECURE=false
