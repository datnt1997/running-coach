# AI
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_PROVIDER=anthropic

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/running_coach

# Strava app registration (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# A secret string you choose — used to verify Strava's webhook handshake
STRAVA_WEBHOOK_VERIFY_TOKEN=your_random_secret_string

# Must match the "Authorization Callback Domain" set in your Strava app
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback
